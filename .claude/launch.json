{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "studio-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "web"
      ],
      "port": 5173,
      "url": "http://localhost:5173"
    },
    {
      "name": "studio-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--prefix",
        "studio",
        "vite",
        "preview",
        "--config",
        "studio/vite.config.ts",
        "studio",
        "--host",
        "127.0.0.1",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173,
      "url": "http://localhost:4173"
    }
  ]
}